# Darl Creates — environment variables.
# Copy to .env.local and fill in. NEVER commit .env.local.

# --- Database (DB Stack Postgres on the agent-server, via Tailscale) ---
# Local dev may point this at a local Postgres instead.
DATABASE_URL="postgresql://USER:PASSWORD@100.90.200.13:5432/darlcreates"

# --- BetterAuth ---
# Generate a secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET="change-me"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AWS S3 (uploads: STL, product photos, customer images, payment proof) ---
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET="darlcreates-uploads"
# Optional CloudFront domain for reads (else signed S3 URLs are used)
CDN_BASE_URL=""

# --- Email (order notifications) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Darl Creates <no-reply@darlcreates.local>"

# --- Payments (manual GCash) — shown to customers at checkout ---
NEXT_PUBLIC_GCASH_NAME="Darl Jed Matundan"
NEXT_PUBLIC_GCASH_NUMBER="0995 900 7319"

# Optional: lets local scripts drop the running app's cached storefront data (see src/app/api/revalidate).
# Leave empty to disable the endpoint.
REVALIDATE_SECRET=""
# REVALIDATE_URL="http://localhost:3001"

# --- Optional display / client settings (all have working defaults; see docs/configuration.md) ---
# Business name and email on the Order Acknowledgment (build-time)
# NEXT_PUBLIC_BUSINESS_NAME="Darl Creates"
# NEXT_PUBLIC_BUSINESS_EMAIL="you@example.com"
# Leave NEXT_PUBLIC_APP_URL unset: the browser auth client then uses the page's own origin.
# NEXT_PUBLIC_APP_URL=""
